APP_NAME=Cognis — LMS & Data Analytics Suite
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite:///./cognis.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Genuine Email & Real SMTP OTP Delivery (e.g., Gmail App Password)
VERIFY_EMAIL_DNS=true
OTP_EXPIRE_MINUTES=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
